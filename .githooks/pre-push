#!/usr/bin/env bash
# Pre-push hook: writes the list of changed files to
# .code-review/last-changed-files.txt and an invocation prompt to
# .code-review/invoke.txt, then blocks the push until the developer
# saves an AI code-review report to .code-review/last-report.md with
# a final VERDICT: line.
#
# The hook itself does not call an LLM. The developer pastes the
# invocation prompt into their AI chat, gets the report, and saves it.
# The hook then reads the verdict and either allows the push or
# blocks it.
#
# Verdict handling (GitHub-style):
#   Request Changes           -> block the push
#   Approve with Suggestions  -> allow the push, print a warning
#   Approve                   -> allow the push silently
#
# Override in emergencies:
#   AI_SKIP_PRE_PUSH=1 git push

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

REVIEW_DIR="$REPO_ROOT/.code-review"
REPORT="$REVIEW_DIR/last-report.md"
CHANGED_FILES="$REVIEW_DIR/last-changed-files.txt"
INVOKE="$REVIEW_DIR/invoke.txt"

mkdir -p "$REVIEW_DIR"

# --- 1. Resolve the remote and the range of commits about to be pushed. ---
REMOTE_BRANCH=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
if [ -z "$REMOTE_BRANCH" ]; then
  echo ""
  echo "[pre-push] no upstream branch set; skipping AI review (initial push)."
  echo "[pre-push] PASS"
  exit 0
fi

CHANGED=$(git diff --name-only "$REMOTE_BRANCH"..HEAD 2>/dev/null || true)
if [ -z "$CHANGED" ]; then
  echo ""
  echo "[pre-push] no changed files in this push; nothing to review."
  echo "[pre-push] PASS"
  exit 0
fi

FILE_COUNT=$(printf "%s\n" "$CHANGED" | wc -l | tr -d ' ')

# --- 2. Print a friendly summary of what is about to be reviewed. ----------
echo ""
echo "============================================================"
echo "  AI Code Review Policy - pre-push"
echo "============================================================"
echo "  Mode:          changed-files"
echo "  Files queued:  $FILE_COUNT"
echo "  Remote ref:    $REMOTE_BRANCH"
echo "  Review dir:    $REVIEW_DIR"
echo "------------------------------------------------------------"

# Print the file list, max 25 lines, then "... and N more" if truncated.
i=0
echo "$CHANGED" | while IFS= read -r path; do
  i=$((i + 1))
  if [ "$i" -le 25 ]; then
    echo "    $path"
  fi
done

# If there are more than 25, show the count. wc on $CHANGED was a single
# newline-separated string, so we re-count by piping the same value.
if [ "$FILE_COUNT" -gt 25 ]; then
  REMAINING=$((FILE_COUNT - 25))
  echo "    ... and $REMAINING more"
fi

echo "============================================================"
echo ""

# --- 3. Write the changed-files list and the invocation prompt. -----------
printf "%s\n" "$CHANGED" > "$CHANGED_FILES"

cat > "$INVOKE" <<EOF
Invoke the Code Review Policy skill in mode=changed-files.

Files to review (one per line, from $CHANGED_FILES):
$CHANGED

Save the full report (with the trailing VERDICT: line) to:
$REPORT
EOF

# --- 4. Decide whether the developer already produced a report. -----------
if [ ! -f "$REPORT" ]; then
  echo "[pre-push] no AI review report found at $REPORT"
  echo ""
  echo "  How to generate it:"
  echo "    1. Open your AI chat."
  echo "    2. Paste the contents of: $INVOKE"
  echo "    3. Save the report to:     $REPORT"
  echo "    4. Re-run:                 git push"
  echo ""
  echo "  Override (emergencies only):  AI_SKIP_PRE_PUSH=1 git push"
  echo ""
  if [ "${AI_SKIP_PRE_PUSH:-0}" = "1" ]; then
    echo "[pre-push] AI_SKIP_PRE_PUSH=1 set; allowing push without review."
    echo "[pre-push] PASS (skipped)"
    exit 0
  fi
  echo "[pre-push] FAIL: blocked. Generate the AI review first."
  exit 1
fi

# --- 5. Read the verdict from the last line of the report. ----------------
# Accepts: "VERDICT: Approve", "VERDICT: Approve with Suggestions",
# "VERDICT: Request Changes". Anything else is treated as a hard error
# so the developer is forced to fix the report format.
VERDICT_RAW=$(grep -E "^VERDICT:" "$REPORT" | tail -n 1 | sed -e 's/^VERDICT:[[:space:]]*//' -e 's/[[:space:]]*$//')

if [ -z "$VERDICT_RAW" ]; then
  echo "[pre-push] FAIL: $REPORT has no 'VERDICT:' line."
  echo "[pre-push] the AI must end its report with one of:"
  echo "    VERDICT: Approve"
  echo "    VERDICT: Approve with Suggestions"
  echo "    VERDICT: Request Changes"
  exit 1
fi

echo "[pre-push] verdict: $VERDICT_RAW"

case "$VERDICT_RAW" in
  "Request Changes")
    echo ""
    echo "[pre-push] FAIL: 'Request Changes' verdict blocks the push."
    echo "[pre-push] fix the High-severity findings in $REPORT and re-run."
    exit 1
    ;;
  "Approve with Suggestions")
    echo ""
    echo "[pre-push] WARN: 'Approve with Suggestions' - allowing push."
    echo "[pre-push] review the Medium findings in $REPORT after pushing."
    echo "[pre-push] PASS"
    ;;
  "Approve")
    echo ""
    echo "[pre-push] 'Approve' - allowing push."
    echo "[pre-push] PASS"
    ;;
  *)
    echo ""
    echo "[pre-push] FAIL: unknown verdict '$VERDICT_RAW' in $REPORT."
    echo "[pre-push] must be one of: Approve | Approve with Suggestions | Request Changes"
    exit 1
    ;;
esac

exit 0
