# Template only. start-app.ps1 replaces the auth setup markers locally before starting auth.
# It also creates frontend/.env and frontend-test/.env with these local API URLs.
# VITE_API_URL=http://localhost:4000
# VITE_FASTAPI_URL=http://localhost:8000

# AI Provider Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Assessment System Configuration
OPENAI_ASSESSMENT_MODEL=o4-mini

# Authentication Configuration
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# Backend API Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Manager Seed Account
SEED_MANAGER_EMAIL=SETUP_REQUIRED
SEED_MANAGER_PASSWORD=SETUP_REQUIRED
SEED_MANAGER_NAME=Local Demo Manager

# Optional GitHub Token (for private repositories)
GITHUB_TOKEN=

# Optional CAPTAPI Configuration (for LinkedIn profile fetching)
CAPTAPI_API_KEY=

# Optional Ollama Configuration (for local LLM provider)
OLLAMA_HOST=http://127.0.0.1:11434

# Optional Concurrency Configuration
ANALYZE_MAX_INFLIGHT=4
ANALYZE_TIMEOUT_S=600
