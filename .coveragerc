[run]
source = .
omit =
    .venv/*
    venv/*
    tests/*
    scripts/*
    skills/*
    conftest.py
    test.py
    */__pycache__/*
    */migrations/*
    */node_modules/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    \.\.\.
